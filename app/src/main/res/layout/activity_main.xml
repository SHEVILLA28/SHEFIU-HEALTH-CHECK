<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="#F5F8FC" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/home" android:orientation="vertical" android:padding="22dp" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="♥  SHEFIU Health Check" android:textColor="#12345B" android:textSize="29sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Whole-body wellness screening" android:textColor="#1769E0" android:textSize="17sp" android:textStyle="bold" android:paddingTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="A guided check from head to feet. Select symptoms you have now and review the safety summary." android:textColor="#40566F" android:textSize="15sp" android:paddingTop="8dp" android:paddingBottom="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="✓  HEAD &amp; SENSES\n✓  CHEST &amp; BREATHING\n✓  STOMACH &amp; URINATION\n✓  BACK &amp; WAIST\n✓  ARMS • HIPS • LEGS • FEET\n✓  SKIN &amp; GENERAL WELLNESS" android:textColor="#12345B" android:textSize="16sp" android:textStyle="bold" android:background="#FFFFFF" android:padding="18dp" android:elevation="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/medicine" android:text="💊  MEDICINE INFORMATION" android:textAllCaps="false" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="48dp"/><Button android:id="@+id/start" android:text="START GENERAL CHECKUP  →" android:textAllCaps="false" android:textSize="17sp" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:text="ⓘ  Not a diagnosis • Camera pulse is experimental" android:textColor="#61758A" android:textSize="13sp" android:gravity="center" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<ScrollView android:id="@+id/medscreen" android:visibility="gone" android:background="#F5F8FC" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="22dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="💊  Medicine Information" android:textColor="#12345B" android:textSize="28sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/medtext" android:textColor="#25384D" android:textSize="16sp" android:paddingTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/medback" android:text="BACK" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="52dp"/></LinearLayout></ScrollView>
<LinearLayout android:id="@+id/scan" android:orientation="vertical" android:visibility="gone" android:background="#050505" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="♥  Gentle pulse scan" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/scan_status" android:text="Rest your fingertip gently over the rear camera and flash. Do NOT press. Stop if uncomfortable." android:textColor="#DDFFFFFF" android:textSize="16sp" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><SurfaceView android:id="@+id/camera" android:layout_width="match_parent" android:layout_height="match_parent"/><View android:layout_width="250dp" android:layout_height="250dp" android:layout_gravity="center" android:background="@drawable/scan_ring"/><LinearLayout android:orientation="vertical" android:gravity="center" android:layout_gravity="center" android:background="#99000000" android:padding="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"><TextView android:id="@+id/bpm" android:text="Preparing scan…" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/signal" android:text="● Waiting for gentle fingertip signal" android:textColor="#FFFFFF" android:textSize="14sp" android:paddingTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></FrameLayout>
<ProgressBar android:id="@+id/scan_progress" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:progress="0" android:layout_width="match_parent" android:layout_height="6dp"/><TextView android:id="@+id/timer" android:text="0:15" android:textColor="#FFFFFF" android:textSize="18sp" android:gravity="center" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><LinearLayout android:orientation="horizontal" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/cancel_scan" android:text="CANCEL" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/finish" android:text="FINISH SCAN" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/></LinearLayout>
</LinearLayout>
<ScrollView android:id="@+id/questions" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="☑  General whole-body checkup" android:textColor="#12345B" android:textSize="27sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Tick symptoms you have now. Leave items blank if they do not apply." android:textColor="#40566F" android:textSize="15sp" android:paddingTop="6dp" android:paddingBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="🧠  HEAD • EYES • EARS • NOSE • THROAT" android:textColor="#1769E0" android:textStyle="bold" android:textSize="16sp" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<CheckBox android:id="@+id/headache" android:text="Headache or head pressure"/><CheckBox android:id="@+id/vision" android:text="Blurred or changed vision"/><CheckBox android:id="@+id/eyePain" android:text="Eye pain or irritation"/><CheckBox android:id="@+id/ear" android:text="Ear pain, hearing change or ringing"/><CheckBox android:id="@+id/throat" android:text="Sore throat or swallowing difficulty"/>
<TextView android:text="♥  CHEST • HEART • BREATHING" android:textColor="#1769E0" android:textStyle="bold" android:textSize="16sp" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><CheckBox android:id="@+id/chest" android:text="Chest pain or pressure"/><CheckBox android:id="@+id/breath" android:text="Serious trouble breathing"/><CheckBox android:id="@+id/palpitations" android:text="Unusual racing, pounding or irregular heartbeat"/>
<TextView android:text="●  STOMACH • BOWEL • URINATION" android:textColor="#1769E0" android:textStyle="bold" android:textSize="16sp" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><CheckBox android:id="@+id/abdominal" android:text="Stomach or abdominal pain"/><CheckBox android:id="@+id/nausea" android:text="Nausea or vomiting"/><CheckBox android:id="@+id/bowel" android:text="New bowel change or blood in stool"/><CheckBox android:id="@+id/urine" android:text="Pain, burning or blood when urinating"/>
<TextView android:text="↕  BACK • WAIST • NECK • JOINTS" android:textColor="#1769E0" android:textStyle="bold" android:textSize="16sp" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><CheckBox android:id="@+id/back" android:text="Back or waist pain"/><CheckBox android:id="@+id/neck" android:text="Neck pain or stiffness"/><CheckBox android:id="@+id/joint" android:text="Joint pain or swelling"/>
<TextView android:text="🦵  ARMS • HANDS • HIPS • LEGS • FEET" android:textColor="#1769E0" android:textStyle="bold" android:textSize="16sp" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><CheckBox android:id="@+id/arm" android:text="Arm or shoulder pain"/><CheckBox android:id="@+id/hand" android:text="Hand or finger pain, numbness or tingling"/><CheckBox android:id="@+id/hip" android:text="Hip pain"/><CheckBox android:id="@+id/leg" android:text="Leg or knee pain"/><CheckBox android:id="@+id/foot" android:text="Foot or ankle pain/swelling"/><CheckBox android:id="@+id/weakness" android:text="New weakness, numbness or trouble walking"/>
<TextView android:text="✚  SKIN • GENERAL WELLNESS" android:textColor="#1769E0" android:textStyle="bold" android:textSize="16sp" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><CheckBox android:id="@+id/skin" android:text="New rash, wound, swelling or skin change"/><CheckBox android:id="@+id/fever" android:text="Fever, chills or feeling unusually hot"/><CheckBox android:id="@+id/fatigue" android:text="Unusual tiredness or low energy"/><CheckBox android:id="@+id/dizzy" android:text="Dizziness or feeling faint"/><CheckBox android:id="@+id/faint" android:text="Fainted or nearly fainted"/><CheckBox android:id="@+id/confusion" android:text="New severe confusion or difficulty staying awake"/>
<TextView android:text="▣  OPTIONAL MEASUREMENTS FROM VALIDATED DEVICES" android:textColor="#1769E0" android:textStyle="bold" android:textSize="16sp" android:paddingTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/sys" android:hint="Blood pressure systolic" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/dia" android:hint="Blood pressure diastolic" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/temp" android:hint="Temperature °C" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/spo2" android:hint="SpO₂ %" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/glucose" android:hint="Glucose reading (optional)" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/result" android:text="VIEW COMPLETE CHECK  →" android:textAllCaps="false" android:textSize="17sp" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="54dp"/>
</LinearLayout></ScrollView>
<ScrollView android:id="@+id/output" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="✓  Your general check" android:textColor="#12345B" android:textSize="28sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/text" android:textColor="#25384D" android:textSize="16sp" android:paddingTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/again" android:text="START ANOTHER CHECK" android:textAllCaps="false" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="54dp"/></LinearLayout></ScrollView>
</FrameLayout>